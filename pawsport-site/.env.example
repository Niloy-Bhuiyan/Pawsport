# Public site URL (used for sitemap, canonical links and social cards)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# GoHighLevel (server only, never prefix with NEXT_PUBLIC_). Leave blank for mock mode:
# forms still work and the payload is printed in the server console.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_INQUIRY_ID=
# Optional: {"pet_name":"<ghl field id>", ...}. Without it, fields are matched by key.
GHL_CUSTOM_FIELD_IDS=
